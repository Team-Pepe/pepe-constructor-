// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique // Asegúrate de que el email sea único
  username        String?
  password        String      // 👈 Campo para almacenar la contraseña encriptada
  roleId          Int         @map("role_id")
  role            Role        @relation(fields: [roleId], references: [id])
  sentMessages    Message[]   @relation("SenderMessages")
  receivedMessages Message[]  @relation("ReceiverMessages")
  sentMessages     Message[]  @relation("SenderMessages")
  requests         Request[]
  assignedTasks    Task[]     @relation("AssignedTasks")
  role             Role       @relation(fields: [roleId], references: [id])
  supervisedZones  WorkZone[]
  materialRequests MaterialRequest[]
  resetToken       String?
  resetTokenExpiry DateTime?

  @@map("users")
}

model Role {
  id           Int      @id @default(autoincrement())
  roleName     String   @map("role_name")
  permissions  String
  users        User[]

  @@map("roles")
}

model WorkZone {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar
  description      String?
  supervisorId     Int               @map("supervisor_id")
  latitud          Float?            @db.Real
  longitud         Float?            @db.Real
  metrics          Metric[]
  tasks            Task[]
  supervisor       User              @relation(fields: [supervisorId], references: [id])
  materiales       ZonaMaterial[]
  materialRequests MaterialRequest[]

  @@map("work_zones")
}

model Task {
  id             Int        @id @default(autoincrement())
  workZoneId     Int        @map("work_zone_id")
  assignedTo     Int        @map("assigned_to")
  description    String
  status         String     @db.VarChar
  completionDate DateTime?  @map("completion_date")
  evidenceUrl    String?    @map("evidence_url") @db.VarChar
  workZone       WorkZone   @relation(fields: [workZoneId], references: [id])
  user           User       @relation("AssignedTasks", fields: [assignedTo], references: [id])

  @@map("tasks")
}

model Material {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar
  description      String?
  quantity         Int
  image_url        String?           @unique
  requests         Request[]
  zonas            ZonaMaterial[]
  materialRequests MaterialRequest[]

  @@map("materials")
}

model Request {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  materialId  Int       @map("material_id")
  requestDate DateTime  @map("request_date")
  status      String    @db.VarChar
  user        User      @relation(fields: [userId], references: [id])
  material    Material  @relation(fields: [materialId], references: [id])

  @@map("requests")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  checkIn   DateTime  @map("check_in")
  checkOut  DateTime? @map("check_out")
  latitud   Float?
  longitud  Float?

  @@map("attendance")
}

model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int       @map("sender_id")
  receiverId  Int       @map("receiver_id")
  message     String
  sentAt      DateTime  @map("sent_at")
  sender      User      @relation("SenderMessages", fields: [senderId], references: [id])
  receiver    User      @relation("ReceiverMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

model Metric {
  id          Int       @id @default(autoincrement())
  workZoneId  Int       @map("work_zone_id")
  metricType  String    @map("metric_type") @db.VarChar
  value       Float
  recordedAt  DateTime  @map("recorded_at")
  workZone    WorkZone  @relation(fields: [workZoneId], references: [id])

  @@map("metrics")
}

model ZonaMaterial {
  id               Int      @id @default(autoincrement())
  id_zona          Int      @map("id_zona")
  id_material      Int      @map("id_material")
  cantidad_asignada Int      @map("cantidad_asignada")
  workZone         WorkZone @relation(fields: [id_zona], references: [id])
  material         Material @relation(fields: [id_material], references: [id])

  @@map("material_zone")
}

model MaterialRequest {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  zone_id            Int
  material_id        Int?
  message            String
  quantity_requested Int
  status             String    @default("pending")
  admin_comment      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [user_id], references: [id])
  zone               WorkZone  @relation(fields: [zone_id], references: [id])
  material           Material? @relation(fields: [material_id], references: [id])

  @@map("material_requests")
}
