generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int        @id @default(autoincrement())
  email            String     @unique
  username         String?
  roleId           Int        @map("role_id")
  password         String
  latitude         Float?
  longitude        Float?
  bloodType        String?
  jobId            Int?       @map("job_id")
  resetToken       String?
  resetTokenExpiry DateTime?
  receivedMessages Message[]  @relation("ReceiverMessages")
  sentMessages     Message[]  @relation("SenderMessages")
  assignedTasks    Task[]     @relation("AssignedTasks")
  role             Role       @relation(fields: [roleId], references: [id])
  job              Job?       @relation(fields: [jobId], references: [id])
  supervisedZones  WorkZone[]

  @@map("users")
}

model Role {
  id          Int    @id @default(autoincrement())
  roleName    String @map("role_name")
  permissions String
  users       User[]

  @@map("roles")
}

model Job {
  id    Int    @id @default(autoincrement()) @map("idJob")
  name  String
  users User[]

  @@map("jobs")
}

model WorkZone {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar
  description  String?
  supervisorId Int            @map("supervisor_id")
  latitud      Float?         @db.Real
  longitud     Float?         @db.Real
  materiales   ZonaMaterial[]
  metrics      Metric[]
  tasks        Task[]
  supervisor   User           @relation(fields: [supervisorId], references: [id])

  @@map("work_zones")
}

model Task {
  id             Int       @id @default(autoincrement())
  workZoneId     Int       @map("work_zone_id")
  assignedTo     Int       @map("assigned_to")
  description    String
  status         String    @db.VarChar
  completionDate DateTime? @map("completion_date")
  evidenceUrl    String?   @map("evidence_url") @db.VarChar
  user           User      @relation("AssignedTasks", fields: [assignedTo], references: [id])
  workZone       WorkZone  @relation(fields: [workZoneId], references: [id])

  @@map("tasks")
}

model Material {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar
  description String?
  quantity    Int
  image_url   String?        @unique
  zonas       ZonaMaterial[]

  @@map("materials")
}

model Attendance {
  id       Int       @id @default(autoincrement())
  userId   Int       @map("user_id")
  checkIn  DateTime  @map("check_in")
  checkOut DateTime? @map("check_out")
  latitud  Float?
  longitud Float?

  @@map("attendance")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  message    String
  sentAt     DateTime @map("sent_at")
  receiver   User     @relation("ReceiverMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model Metric {
  id         Int      @id @default(autoincrement())
  workZoneId Int      @map("work_zone_id")
  metricType String   @map("metric_type") @db.VarChar
  value      Float
  recordedAt DateTime @map("recorded_at")
  workZone   WorkZone @relation(fields: [workZoneId], references: [id])

  @@map("metrics")
}

model ZonaMaterial {
  id                Int      @id @default(autoincrement())
  id_zona           Int      @map("id_zona")
  id_material       Int      @map("id_material")
  cantidad_asignada Int      @map("cantidad_asignada")
  material          Material @relation(fields: [id_material], references: [id])
  workZone          WorkZone @relation(fields: [id_zona], references: [id])

  @@map("material_zone")
}

model MaterialRequest {
  id                 BigInt    @id @default(autoincrement())
  zone_id            BigInt
  quantity_requested Float?
  message            String?
  status             String?   @db.VarChar
  created_at         DateTime? @db.Timestamp(6)
  user_id            Int?
  material           String?

  @@map("material_requests")
}

model CheckIn {
  id           BigInt    @id @default(autoincrement())
  user_id      Int       @map("user_id")
  zone_id      Int?      @map("zone_id")
  checkInTime  DateTime? @map("check_in_time") @db.Timestamp(6)
  latitude     Float?
  longitude    Float?
  photo_url    String?   @map("photo_url")
  status       String?   @default("active") @db.VarChar
  checkOutTime DateTime? @map("check_out_time") @db.Timestamp(6)
  workDate     DateTime? @map("work_date") @db.Date

  @@map("check_ins")
}

model requests {
  id           Int      @id @default(autoincrement())
  user_id      Int
  material_id  Int
  request_date DateTime
  status       String   @db.VarChar
}
