// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt       @id @default(autoincrement())
  username        String       
  password        String
  email           String
  role            String
  sentMessages     Message[]    @relation("SenderMessages")
  receivedMessages Message[]    @relation("ReceiverMessages")
  assignedTasks   Task[]        @relation("AssignedTasks")
  requests        Request[]
  supervisedZones WorkZone[]

  @@map("users")
}


model Role {
  id           BigInt   @id @default(autoincrement())
  roleName     String   @map("role_name")
  permissions  String

  @@map("roles")
}

model WorkZone {
  id           BigInt    @id @default(autoincrement())
  name         String
  description  String?
  supervisorId BigInt?   @map("supervisor_id")
  supervisor   User?     @relation(fields: [supervisorId], references: [id])
  tasks        Task[]
  metrics      Metric[]

  @@map("work_zones")
}

model Task {
  id             BigInt      @id @default(autoincrement())
  workZoneId     BigInt?     @map("work_zone_id")
  assignedTo     BigInt?     @map("assigned_to")
  description    String
  status         String
  completionDate DateTime?   @map("completion_date")
  evidenceUrl    String?     @map("evidence_url")
  workZone       WorkZone?   @relation(fields: [workZoneId], references: [id])
  user           User?       @relation("AssignedTasks", fields: [assignedTo], references: [id])

  @@map("tasks")
}

model Material {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?
  quantity    Int
  requests    Request[]

  @@map("materials")
}

model Request {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt?   @map("user_id")
  materialId  BigInt?   @map("material_id")
  requestDate DateTime  @map("request_date")
  status      String
  user        User?     @relation(fields: [userId], references: [id])
  material    Material? @relation(fields: [materialId], references: [id])

  @@map("requests")
}

model Attendance {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?   @map("user_id")
  checkIn   DateTime  @map("check_in")
  checkOut  DateTime? @map("check_out")
  latitud   Float?
  longitud  Float?

  @@map("attendance")
}

model Message {
  id          BigInt    @id @default(autoincrement())
  senderId    BigInt?   @map("sender_id")
  receiverId  BigInt?   @map("receiver_id")
  message     String
  sentAt      DateTime  @map("sent_at")
  sender      User?     @relation("SenderMessages", fields: [senderId], references: [id])
  receiver    User?     @relation("ReceiverMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

model Metric {
  id          BigInt    @id @default(autoincrement())
  workZoneId  BigInt?   @map("work_zone_id")
  metricType  String    @map("metric_type")
  value       Decimal
  recordedAt  DateTime  @map("recorded_at")
  workZone    WorkZone? @relation(fields: [workZoneId], references: [id])

  @@map("metrics")
}